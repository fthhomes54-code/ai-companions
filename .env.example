# === LLM (required for chat / memory / outreaches / voice) ===
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_IMAGE_MODEL=dall-e-3

# === Supabase Auth + DB (required for persistence) ===
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === Cron (required for holiday / birthday outreaches) ===
# Vercel: set CRON_SECRET; cron calls /api/cron/outreaches with Authorization: Bearer <CRON_SECRET>
CRON_SECRET=generate-a-long-random-string

# === Optional image gen (DALL·E self-photos) ===
ENABLE_IMAGE_GEN=false
NEXT_PUBLIC_ENABLE_IMAGE_GEN=false

# === Stripe (stub — wire later) ===
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# === App ===
NEXT_PUBLIC_SITE_URL=http://localhost:3000
